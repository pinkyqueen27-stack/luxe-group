# 本機開發用範例(複製成 .env.local 再填入)。
# 不填 Firebase 欄位 = 本機測試模式(資料只存在這個瀏覽器)。
# 注意:Firebase 網頁設定是「專案識別資訊」不是密碼,真正的保護來自 Firestore 規則。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 主召後台「測試入口」密碼(前端密碼並不安全,僅防誤觸;未設定時預設為 luxe2026)
VITE_ADMIN_PIN=
